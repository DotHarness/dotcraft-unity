.welcome-composer-host .button-row,
.bottom-composer-host .button-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.welcome-composer-host .config-row,
.bottom-composer-host .config-row {
    flex-direction: row;
    align-items: center;
}

.welcome-composer-host .composer-icon-button,
.bottom-composer-host .composer-icon-button {
    background-color: transparent;
    border-width: 0;
    width: 28px;
    height: 28px;
    margin-right: 8px;
    color: rgba(220, 220, 220, 0.76);
}

.welcome-composer-host .composer-icon-button:hover,
.bottom-composer-host .composer-icon-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: transparent;
}

.welcome-composer-host .config-popup,
.bottom-composer-host .config-popup {
    margin-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
}

.welcome-composer-host .config-popup .unity-base-popup-field__label,
.bottom-composer-host .config-popup .unity-base-popup-field__label {
    color: rgba(190, 190, 190, 0.68);
}

.welcome-composer-host .config-popup .unity-base-popup-field__popup,
.welcome-composer-host .config-popup .unity-base-field__input,
.welcome-composer-host .config-popup .unity-base-popup-field__input,
.welcome-composer-host .config-popup .unity-popup-field__input,
.bottom-composer-host .config-popup .unity-base-popup-field__popup,
.bottom-composer-host .config-popup .unity-base-field__input,
.bottom-composer-host .config-popup .unity-base-popup-field__input,
.bottom-composer-host .config-popup .unity-popup-field__input {
    background-color: transparent;
    border-width: 0;
}

.welcome-composer-host .config-popup .unity-base-popup-field__popup,
.bottom-composer-host .config-popup .unity-base-popup-field__popup {
    min-width: 72px;
}

.welcome-composer-host .send-button,
.bottom-composer-host .send-button {
    background-color: rgba(245, 245, 245, 0.92);
    color: #222222;
    border-radius: 14px;
    width: 28px;
    height: 28px;
    margin-left: 10px;
    font-size: 17px;
}

.welcome-composer-host .send-button:hover,
.bottom-composer-host .send-button:hover {
    background-color: #FFFFFF;
}

.welcome-composer-host .stop-button,
.bottom-composer-host .stop-button {
    background-color: rgba(245, 245, 245, 0.92);
    color: #222222;
    border-radius: 14px;
    width: 28px;
    height: 28px;
    margin-left: 10px;
    font-size: 11px;
}

.welcome-composer-host .stop-button:hover,
.bottom-composer-host .stop-button:hover {
    background-color: #FFFFFF;
}

/* ── Attachments ── */
.attachments-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.attachment-item {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 4px;
    padding: 2px 5px;
    margin-right: 5px;
    margin-bottom: 4px;
}

.sent-attachment {
    align-self: flex-end;
    margin: 2px 14px 6px 14px;
    max-width: 86%;
}

.attachment-icon {
    width: 14px;
    height: 14px;
    min-width: 14px;
    min-height: 14px;
    margin-right: 5px;
    flex-shrink: 0;
}

.attachment-name {
    font-size: 11px;
    color: rgba(220, 220, 220, 0.88);
    margin-right: 3px;
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.remove-attachment {
    background-color: transparent;
    border-width: 0;
    color: rgba(210, 210, 210, 0.62);
    font-size: 12px;
    width: 16px;
    height: 16px;
    padding: 0;
    margin-left: 2px;
    -unity-text-align: middle-center;
}

.remove-attachment:hover {
    color: rgba(255, 255, 255, 0.92);
    background-color: rgba(255, 255, 255, 0.08);
}

/* ── Workspace validation banner ── */
.workspace-banner {
    flex-direction: column;
    padding: 8px 10px;
    background-color: rgba(211, 47, 47, 0.18);
    border-bottom-width: 1px;
    border-bottom-color: rgba(211, 47, 47, 0.45);
}

.workspace-banner-label {
    font-size: 11px;
    color: #EF9A9A;
    white-space: normal;
}

.workspace-banner-buttons {
    flex-direction: row;
    margin-top: 6px;
}

.workspace-banner-action {
    font-size: 11px;
    padding: 2px 8px;
    margin-right: 6px;
    border-radius: 3px;
}
