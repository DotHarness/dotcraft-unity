<Project>
  <PropertyGroup>
    <UnityPluginManifest>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Plugins/unity/.craft-plugin/plugin.json'))</UnityPluginManifest>
    <UnityProductVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(UnityPluginManifest)')), '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</UnityProductVersion>
    <Version>$(UnityProductVersion)</Version>
    <InformationalVersion>$(UnityProductVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
